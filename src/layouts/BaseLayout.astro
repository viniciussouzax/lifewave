---
import '../styles/global.css';
import { readData } from '../lib/readData';
import HeadPlugins from '../plugins/_slots/HeadPlugins.astro';
import BodyEndPlugins from '../plugins/_slots/BodyEndPlugins.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const siteConfig = readData('siteConfig.json');
const pluginsConfig = readData('pluginsConfig.json', {});
const gscVerificationTag = (pluginsConfig as any)?.searchConsole?.verificationTag?.trim() || '';

const primaryHex = siteConfig.theme?.primary || '#1c64c8';
// Combinações de fonte selecionáveis no admin (Configurações → Combinação de Fontes).
// REGRA: o CORPO é sempre Geist (base do tema, self-hosted em global.css). O combo
// muda SÓ a fonte dos TÍTULOS (display). Cada combo carrega apenas a fonte de título
// que precisa via <link> no <head> (default/lora usam a Lora self-hosted).
const FONT_MAP: Record<string, { display: string; body: string; href: string }> = {
  default:    { display: 'Lora', body: 'Geist', href: '' },
  montserrat: { display: 'Montserrat', body: 'Geist', href: 'https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap' },
  inter:      { display: 'Inter', body: 'Geist', href: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap' },
  outfit:     { display: 'Outfit', body: 'Geist', href: 'https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap' },
  roboto:     { display: 'Roboto', body: 'Geist', href: 'https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap' },
  poppins:    { display: 'Poppins', body: 'Geist', href: 'https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap' },
  playfair:   { display: 'Playfair Display', body: 'Geist', href: 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap' },
};
const font = FONT_MAP[siteConfig.theme?.font || 'default'] || FONT_MAP.default;

function hexToRgbTriplet(hex: string): string {
  const h = hex.replace('#', '').trim();
  if (h.length !== 6) return '28 100 200';
  const r = parseInt(h.substring(0, 2), 16);
  const g = parseInt(h.substring(2, 4), 16);
  const b = parseInt(h.substring(4, 6), 16);
  return `${r} ${g} ${b}`;
}
function soften(hex: string): string {
  const h = hex.replace('#', '').trim();
  if (h.length !== 6) return '228 235 247';
  const r = Math.round(parseInt(h.substring(0, 2), 16) * 0.1 + 255 * 0.9);
  const g = Math.round(parseInt(h.substring(2, 4), 16) * 0.1 + 255 * 0.9);
  const b = Math.round(parseInt(h.substring(4, 6), 16) * 0.1 + 255 * 0.9);
  return `${r} ${g} ${b}`;
}

// ── Fonte da marca (override por projeto) — afeta só os títulos (--font-display).
// Duas origens: Google Fonts (por nome) ou arquivo próprio self-hosted (upload no
// admin, commitado em /public/fonts). Guardas: sanitiza a família e valida a URL/caminho
// pra não injetar CSS/HTML arbitrário no <head>.
const brand = siteConfig.theme?.brandFont || null;
const brandFamily = String(brand?.family || '').replace(/["'\\;{}<>]/g, '').trim();
const brandFilePath = typeof brand?.filePath === 'string' && /^\/fonts\/[\w.-]+\.(woff2|woff|ttf|otf)$/i.test(brand.filePath) ? brand.filePath : '';
const brandGoogleUrl = typeof brand?.googleUrl === 'string' && /^https:\/\/fonts\.(googleapis|gstatic)\.com\//.test(brand.googleUrl) ? brand.googleUrl : '';
const brandActive = !!(brandFamily && ((brand?.source === 'google' && brandGoogleUrl) || (brand?.source === 'upload' && brandFilePath)));
const brandFmt = brandFilePath.endsWith('.ttf') ? 'truetype' : brandFilePath.endsWith('.otf') ? 'opentype' : brandFilePath.endsWith('.woff') ? 'woff' : 'woff2';
const brandType = brandFilePath.endsWith('.ttf') ? 'font/ttf' : brandFilePath.endsWith('.otf') ? 'font/otf' : brandFilePath.endsWith('.woff') ? 'font/woff' : 'font/woff2';
// @font-face sem font-weight fixo (default 400) → aceita fonte de peso único sem
// impedir faux-bold nos títulos mais pesados; os títulos-base já são weight 400.
const brandFontFace = brandActive && brand.source === 'upload'
  ? `@font-face{font-family:'${brandFamily}';font-style:normal;font-display:swap;src:url('${brandFilePath}') format('${brandFmt}');}`
  : '';

// No set default (self-hosted Lora/Geist) incluímos as famílias "Fallback" com
// métricas calibradas na cadeia — o style inline sobrescreve o :root do global.css,
// então precisam estar aqui pra o anti-CLS valer. Sets do Google usam fallback genérico.
const displayStack = brandActive
  ? `'${brandFamily}', Georgia, system-ui, sans-serif`
  : font.href
    ? `'${font.display}', Georgia, system-ui, sans-serif`
    : `'${font.display}', 'Lora Fallback', Georgia, serif`;
// Corpo é sempre Geist self-hosted → sempre com o fallback de métricas calibradas.
const bodyStack = `'${font.body}', 'Geist Fallback', system-ui, -apple-system, sans-serif`;

const cssVars = `
  --c-primary: ${hexToRgbTriplet(primaryHex)};
  --c-primary-soft: ${soften(primaryHex)};
  --font-display: ${displayStack};
  --font-body: ${bodyStack};
`;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  bodyClass?: string;
  hideTopBars?: boolean;
  flushFooter?: boolean;
}

const defaultTitle = siteConfig.seo?.title || siteConfig.name;
const {
  title = defaultTitle,
  description = siteConfig.seo?.description || siteConfig.description,
  image = '',
  type = 'website',
  bodyClass = '',
  hideTopBars = false,
  flushFooter = false,
} = Astro.props;

// Barra de aviso/CTA no topo (acima da nav), só nas páginas de artigo. Editável em articleCta.json.
const articleCta = readData('articleCta.json', {}) as any;
const announcement = articleCta?.announcement || {};
// A barra clara acima da nav vira o aviso da "próxima apresentação" (com timer).
const showAnnouncement = announcement?.enabled !== false && !hideTopBars;
const annUrl = (u: any) => (typeof u === 'string' && u.trim()) ? u.trim() : '/#hero-form';
const hexOr = (v: any, fb: string) => (typeof v === 'string' && /^#[0-9a-fA-F]{3,8}$/.test(v.trim())) ? v.trim() : fb;
const annBg = hexOr(announcement?.bg, '#ECF5FA');
const annColor = hexOr(announcement?.textColor, '#373F41');

// Barra de aviso ESCURA no topo (acima da faixa clara), só em artigos.
const topNotice = articleCta?.topNotice || {};
const showTopNotice = topNotice?.enabled !== false
  && !!((topNotice?.text || '').trim() || (topNotice?.buttonLabel || '').trim())
  && !hideTopBars;
const topBg = hexOr(topNotice?.bg, '#194F90');
const topColor = hexOr(topNotice?.textColor, '#ffffff');

const formattedTitle = title === defaultTitle ? title : `${title} | ${siteConfig.name}`;
// Normaliza a base: domínio salvo no admin pode vir sem protocolo (ex.: "exemplo.com.br").
// new URL() exige base absoluta — sem isso o build quebra com "Invalid URL" (BUILD-05).
const rawSiteUrl = (siteConfig.url || Astro.url.origin || '').trim();
const siteUrl = rawSiteUrl && !/^https?:\/\//i.test(rawSiteUrl) ? `https://${rawSiteUrl}` : rawSiteUrl;
// Nenhum new URL com base de dado do usuário pode derrubar o build → try/catch com fallback seguro.
function toAbsoluteUrl(path: string, base: string): string {
  if (!path) return '';
  if (/^https?:\/\//i.test(path)) return path;
  try {
    return new URL(path, base).toString();
  } catch {
    return path; // fallback: path relativo (não derruba o build)
  }
}
const socialImage = toAbsoluteUrl(image, siteUrl);
import CustomCodeBodyStart from '../plugins/custom-code/CustomCodeBodyStart.astro';
---
<!DOCTYPE html>
<html lang={siteConfig.language || 'pt-BR'} style={cssVars}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{formattedTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={siteConfig.favicon || '/favicon.svg'} />
  {font.href && <link rel="stylesheet" href={font.href} />}
  {/* Fonte da marca (override dos títulos): Google Fonts ou arquivo self-hosted */}
  {brandActive && brand.source === 'google' && <link rel="stylesheet" href={brandGoogleUrl} />}
  {brandActive && brand.source === 'upload' && (
    <>
      <link rel="preload" as="font" type={brandType} href={brandFilePath} crossorigin />
      <style set:html={brandFontFace}></style>
    </>
  )}
  {/* Corpo é sempre Geist self-hosted → preload sempre. Lora (título default) só quando não há combo Google. */}
  <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-var.woff2" crossorigin />
  {!font.href && !brandActive && (
    <link rel="preload" as="font" type="font/woff2" href="/fonts/lora-var.woff2" crossorigin />
  )}

  {gscVerificationTag && (
    gscVerificationTag.startsWith('<')
      ? <Fragment set:html={gscVerificationTag} />
      : <meta name="google-site-verification" content={gscVerificationTag} />
  )}

  <meta property="og:type" content={type} />
  <meta property="og:title" content={formattedTitle} />
  <meta property="og:description" content={description} />
  {socialImage && <meta property="og:image" content={socialImage} />}
  <meta property="og:url" content={Astro.url} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={formattedTitle} />
  <meta name="twitter:description" content={description} />
  {socialImage && <meta name="twitter:image" content={socialImage} />}

  <HeadPlugins />
</head>

<body class={bodyClass}>
<CustomCodeBodyStart />
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-ink focus:text-bg focus:px-4 focus:py-2 focus:rounded focus:mono">
    pular pro conteúdo
  </a>

  {showTopNotice && (
    <a
      href={annUrl(topNotice.buttonUrl)}
      class="block text-center text-[0.768rem] font-medium py-[0.4rem] px-[0.64rem] no-underline hover:brightness-110 transition-[filter]"
      style={`background:${topBg};color:${topColor}`}
    >
      <span>{topNotice.text}</span>
      {topNotice.buttonLabel && (
        <span class="font-semibold underline underline-offset-2 ml-1.5 whitespace-nowrap text-[#5EB3E4]">{topNotice.buttonLabel} →</span>
      )}
    </a>
  )}

  {showAnnouncement && (
    <a
      href={annUrl(announcement.buttonUrl)}
      class="block text-center text-[0.768rem] font-medium py-[0.4rem] px-[0.64rem] no-underline border-b-2 border-[#8DC9EC] hover:brightness-95 transition-[filter]"
      style={`background:${annBg};color:${annColor}`}
    >
      <span class="cta-live-dot mr-1.5"></span><span>Nossa próxima apresentação sobre a LifeWave começa em <span class="whitespace-nowrap"><span aria-hidden="true" class="mr-1">⏱️</span><strong class="font-semibold tabular-nums" data-countdown>00:00:00</strong></span>. Participe e tire suas dúvidas em tempo real.</span>
      {announcement.buttonLabel && (
        <span class="font-semibold underline underline-offset-2 ml-1.5 whitespace-nowrap text-[#5EB3E4]">{announcement.buttonLabel} →</span>
      )}
    </a>
  )}

  <Header />

  <main id="main">
    <slot />
  </main>

  <Footer flush={flushFooter} />

  <BodyEndPlugins />

  <!-- Contador regressivo até o próximo webinar do dia (11:00, 15:00, 20:00).
       Após o último horário, conta para o primeiro do dia seguinte. Horário local.
       Alimenta todos os [data-countdown] da página (barra de aviso + cards do artigo). -->
  <script is:inline>
    (function(){
      var els = document.querySelectorAll('[data-countdown]');
      if(!els.length && !document.querySelector('[data-cd]')) return;
      var TIMES = [[11, 0], [15, 0], [20, 0]];
      function pad(n){ return (n < 10 ? '0' : '') + n; }
      function nextStart(now){
        // A programação de webinars começa 20/08/2026 às 11h. Antes disso, conta para a 1ª sessão.
        var firstSession = new Date(2026, 7, 20, 11, 0, 0, 0);
        if(now.getTime() < firstSession.getTime()) return firstSession;
        for(var i = 0; i < TIMES.length; i++){
          var d = new Date(now);
          d.setHours(TIMES[i][0], TIMES[i][1], 0, 0);
          if(d.getTime() > now.getTime()) return d;
        }
        var t = new Date(now);
        t.setDate(t.getDate() + 1);
        t.setHours(TIMES[0][0], TIMES[0][1], 0, 0);
        return t;
      }
      function tick(){
        var now = new Date();
        var target = nextStart(now);
        var remaining = Math.max(0, Math.floor((target.getTime() - now.getTime()) / 1000));
        var d = Math.floor(remaining / 86400);
        var h = Math.floor((remaining % 86400) / 3600);
        var m = Math.floor((remaining % 3600) / 60);
        var s = remaining % 60;
        var txt = (d > 0 ? d + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
        for(var i = 0; i < els.length; i++){ els[i].textContent = txt; }
        // Caixas segmentadas (dias/horas/min/seg) nos cards
        setSeg('d', pad(d)); setSeg('h', pad(h)); setSeg('m', pad(m)); setSeg('s', pad(s));
      }
      function setSeg(k, v){
        var list = document.querySelectorAll('[data-cd="' + k + '"]');
        for(var i = 0; i < list.length; i++){ list[i].textContent = v; }
      }
      // Data da próxima sessão (eyebrow da landing) — preenchido uma vez.
      var ns = document.querySelector('[data-next-session]');
      if(ns){
        var nt = nextStart(new Date());
        try {
          ns.textContent = nt.toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: 'long' }) + ' às ' + nt.getHours() + 'h (GMT-3)';
        } catch(e){}
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>
</body>
</html>
