---
import BaseLayout from '../layouts/BaseLayout.astro';
import WebinarLanding from '../components/local/WebinarLanding.astro';

const title = 'Apresentação online e gratuita — LifeWave';
const description = 'Uma nova conversa sobre saúde, longevidade e o potencial do corpo humano: peptídeos, regeneração celular e fotobiomodulação. Escolha o seu horário e participe da apresentação online e gratuita.';
---

<BaseLayout title={title} description={description} hideTopBars={true} flushFooter={true}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" />
  </Fragment>
  <WebinarLanding />
</BaseLayout>
