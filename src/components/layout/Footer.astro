---
import { readData } from '../../lib/readData';
import { normalizeCategories, collectOrphanCategories } from '../../lib/categorySlug';
import { getCollection } from 'astro:content';
import { BRAND_ICONS } from '../../lib/brandIcons';

interface Props { flush?: boolean }
const { flush = false } = Astro.props;

const siteConfig = readData('siteConfig.json');
const menuItems: any[] = readData('menu.json', { items: [] }).items || [];

const posts = await getCollection('blog');
const categoriesData = readData('categories.json', []);
const registered = normalizeCategories(categoriesData);
const postCats = [...new Set(posts.map(p => p.data.category).filter(Boolean))];
const orphans = collectOrphanCategories(postCats, registered);
const allCategories = (registered.length > 0 ? [...registered, ...orphans] : orphans).slice(0, 6);

const year = new Date().getFullYear();
const BRAND = '#194f90';

const socials: Array<[string, string, string]> = [
  ['instagram', 'Instagram', siteConfig.social?.instagram],
  ['twitter', 'Twitter / X', siteConfig.social?.twitter],
  ['facebook', 'Facebook', siteConfig.social?.facebook],
  ['youtube', 'YouTube', siteConfig.social?.youtube],
  ['linkedin', 'LinkedIn', siteConfig.social?.linkedin],
  ['pinterest', 'Pinterest', siteConfig.social?.pinterest],
  ['github', 'GitHub', siteConfig.social?.github],
].filter(([_, __, href]: any) => href) as any;

// Links legais/institucionais do rodapé (páginas reais do site)
const legal = [
  ['Quem somos', '/quem-somos'],
  ['Privacidade', '/privacidade'],
  ['Termos', '/termos'],
];

// Galeria do Instagram (opcional)
const igItems = (Array.isArray(siteConfig.instagramFeed) ? siteConfig.instagramFeed : [])
  .map((i: any) => (typeof i === 'string' ? { src: i, link: '' } : (i || {})))
  .filter((i: any) => i.src)
  .slice(0, 6);
const igProfile = siteConfig.social?.instagram || '';
---

<footer class={flush ? '' : 'mt-24'}>
  <!-- Área principal (fundo com o padrão de bolhas) -->
  <div class="footer-bubbles">
    <div class="container-x py-14 md:py-16">
      <div class="grid grid-cols-2 md:grid-cols-12 gap-x-8 gap-y-10">

        <!-- Marca -->
        <div class="col-span-2 md:col-span-4">
          <a href="/" class="no-underline inline-block mb-4" aria-label={siteConfig.name}>
            {siteConfig.logo ? (
              <img src={siteConfig.logo} alt={siteConfig.name} style={`height: ${siteConfig.logoHeight ?? 40}px`} class="w-auto" />
            ) : (
              <span class="font-display text-2xl font-bold text-[#194f90] tracking-tight">{siteConfig.name}</span>
            )}
          </a>
          <p class="text-sm text-[#194f90] leading-relaxed max-w-xs">
            {siteConfig.footer?.description || siteConfig.description}
          </p>
        </div>

        <!-- Navegação -->
        <div class="md:col-span-3">
          <p class="mono uppercase text-[#373f41]/70 text-xs mb-4">navegação</p>
          <ul class="space-y-2.5 text-sm">
            {menuItems.map((item: any) => (
              <li><a href={item.href} class="text-[#194f90] hover:text-[#5EB3E4] transition-colors">{item.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Tópicos -->
        <div class="md:col-span-2">
          <p class="mono uppercase text-[#373f41]/70 text-xs mb-4">tópicos</p>
          <ul class="space-y-2.5 text-sm">
            {[['Comece aqui', '/categoria/comece-aqui'], ['Bem-estar', '/categoria/bem-estar'], ['Tecnologia', '/categoria/tecnologia']].map(([label, href]) => (
              <li><a href={href} class="text-[#194f90] hover:text-[#5EB3E4] transition-colors">{label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Participe da conversa -->
        {socials.length > 0 && (
          <div class="col-span-2 md:col-span-3">
            <p class="mono uppercase text-[#373f41]/70 text-xs mb-4">participe da conversa</p>
            <div class="flex flex-wrap gap-2.5">
              {socials.map(([key, label, href]: any) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={label}
                  class="w-9 h-9 rounded-full flex items-center justify-center text-white hover:brightness-110 transition-[filter]"
                  style={`background:${BRAND}`}
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={BRAND_ICONS[key] || ''} /></svg>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      {igItems.length > 0 && (
        <div class="pt-12 mt-2">
          <p class="mono uppercase text-[#373f41]/70 text-xs mb-4">instagram</p>
          <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 md:gap-3">
            {igItems.map((item: any) => (
              <a href={item.link || igProfile || '#'} target="_blank" rel="noopener noreferrer" class="block aspect-square overflow-hidden rounded-md bg-elev group" aria-label="Ver no Instagram">
                <img src={item.src} alt="Instagram" loading="lazy" class="w-full h-full object-cover group-hover:opacity-85 transition-opacity" />
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Barra inferior (azul da marca) -->
  <div style={`background:${BRAND}`}>
    <div class="container-x py-4 flex items-center justify-between flex-wrap gap-x-6 gap-y-2 text-xs text-white/80">
      <span>© {year} {siteConfig.footer?.copyright || siteConfig.name} | All rights reserved</span>
      <nav class="flex flex-wrap gap-x-5 gap-y-1" aria-label="Links do rodapé">
        {legal.map(([label, href]) => (
          <a href={href} class="hover:text-white transition-colors">{label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  /* Fundo de bolhas responsivo: escala com a largura, mas cresce nas telas
     menores pra não virar uma faixa fininha no rodapé. */
  .footer-bubbles {
    background-color: #ECF5FA;
    background-image: url('/assets/footer-background.svg');
    background-repeat: no-repeat;
    background-position: bottom center;
    background-size: 100% auto;
  }
  @media (max-width: 768px) {
    .footer-bubbles { background-size: 180% auto; }
  }
  @media (max-width: 480px) {
    .footer-bubbles { background-size: 280% auto; }
  }
</style>
