---
/**
 * ProdutosPage.astro — catálogo completo dos produtos LifeWave.
 * Fonte: knowledge/products/catalogo-loja-oficial.md (25 produtos, 7 categorias).
 * No Brasil a compra é com orientação de um Brand Partner → CTA para WhatsApp.
 */
import { readData } from '../../lib/readData';

const biz = readData('localBusiness.json', {}) as any;
const waNumber = (biz.whatsapp || '').replace(/\D/g, '');
const waLink = waNumber
  ? `https://wa.me/${waNumber}?text=${encodeURIComponent('Olá! Vim pelo site e gostaria de conhecer os produtos LifeWave.')}`
  : '/';

const categorias = [
  {
    nome: 'Bem-estar & Vitalidade',
    produtos: [
      { nome: 'LifeWave X39®', desc: 'Adesivo de fototerapia que eleva o peptídeo GHK-Cu — apoia energia, desempenho no exercício e o bem-estar geral.', preco: 'US$ 149,95' },
      { nome: 'LifeWave X49™', desc: 'Adesivo voltado a desempenho, força, resistência, saúde cardiovascular no exercício e recuperação.', preco: 'US$ 149,95' },
      { nome: 'X39® & X49® Performance Bundle', desc: 'Combo dos dois adesivos: energia e saúde geral (X39) + desempenho e recuperação (X49).', preco: 'US$ 279,95' },
    ],
  },
  {
    nome: 'Bem-estar geral',
    produtos: [
      { nome: 'Cellular Performance System', desc: 'Adesivo X39 + pó Cellergize Morning — apoia atividade celular, nutrição e resiliência.', preco: 'US$ 229,90' },
      { nome: 'Cellergize™ Duo', desc: 'Cellergize Morning + Evening: energia e defesa antioxidante de dia, preparação para o sono à noite.', preco: 'US$ 149,95' },
      { nome: 'Cellergize™ Morning', desc: 'Bebida matinal (limão e gengibre) que apoia células-tronco, glutationa e defesa antioxidante.', preco: 'US$ 79,95' },
      { nome: 'Cellergize™ Evening', desc: 'Bebida noturna (mel e lavanda) para relaxamento, preparação ao sono e saúde digestiva.', preco: 'US$ 79,95' },
      { nome: 'Y-Age System Kit', desc: 'Os três adesivos Y-Age — Aeon, Carnosine e Glutathione — com protocolo de rodízio.', preco: 'US$ 209,85' },
      { nome: 'Y-Age Aeon®', desc: 'Adesivo que promove relaxamento e ajuda na gestão do estresse.', preco: 'US$ 79,95' },
      { nome: 'Y-Age Glutathione®', desc: 'Adesivo que apoia a aparência da pele, o relaxamento e a saúde geral.', preco: 'US$ 79,95' },
      { nome: 'Y-Age Carnosine®', desc: 'Adesivo que incentiva a atividade física e o bem-estar geral.', preco: 'US$ 79,95' },
      { nome: 'SP6 Complete®', desc: 'Adesivo que apoia uma abordagem consciente para manter o apetite saudável.', preco: 'US$ 79,95' },
      { nome: 'AcuLife® (equino)', desc: 'Adesivo de acupressão exclusivo para cavalos — efeito calmante e flexibilidade. Apenas equinos.', preco: 'US$ 79,95' },
    ],
  },
  {
    nome: 'Movimento',
    produtos: [
      { nome: 'IceWave®', desc: 'Fototerapia de ação rápida, sem drogas nem estimulantes, para apoiar o movimento.', preco: 'US$ 79,95' },
    ],
  },
  {
    nome: 'Energia',
    produtos: [
      { nome: 'Energy Enhancer®', desc: 'Par de adesivos que promove o fluxo de energia junto da rotina de atividade física.', preco: 'US$ 79,95' },
    ],
  },
  {
    nome: 'Sono',
    produtos: [
      { nome: 'Silent Nights®', desc: 'Adesivo noturno que favorece o relaxamento para melhorar a qualidade e a duração do sono.', preco: 'US$ 79,95' },
    ],
  },
  {
    nome: 'Cuidados com a pele',
    produtos: [
      { nome: 'Alavida®', desc: 'Adesivo noturno que equilibra a energia restauradora do corpo para uma pele com aparência radiante.', preco: 'US$ 79,95' },
      { nome: 'Alavida® Nightly Restore Facial Crème', desc: 'Tratamento facial noturno: reduz a aparência de linhas finas, uniformiza o tom e hidrata.', preco: 'US$ 99,95' },
      { nome: 'Alavida® Facial Nectar', desc: 'Hidratante facial diurno, complementar ao creme noturno.', preco: 'US$ 79,95' },
      { nome: 'Alavida® Revive Eye Cream', desc: 'Creme para a área dos olhos com peptídeos de cobre — firmeza e luminosidade.', preco: 'US$ 89,95' },
      { nome: 'Alavida® Regenerating Trio', desc: 'Adesivos Alavida + creme noturno + néctar diurno, num só kit.', preco: 'US$ 199,95' },
    ],
  },
  {
    nome: 'Tecnologia da água',
    produtos: [
      { nome: 'LifeWave X₂O™ Light-Infused™ Water', desc: 'Sistema de filtragem com infusão de luz e enriquecimento com hidrogênio, para hidratação em nível celular.', preco: 'US$ 5.995,00' },
      { nome: 'X₂O™ Filter Replacement Bundle', desc: 'Kit com filtro primário e secundário de reposição (troca a cada ~6 meses).', preco: 'US$ 170,00' },
      { nome: 'X₂O™ Primary Filter', desc: 'Filtro de reposição do primeiro estágio, reduz impurezas da água.', preco: 'US$ 95,00' },
      { nome: 'X₂O™ Secondary Filter', desc: 'Filtro final: melhora sabor e carrega a água com hidrogênio molecular.', preco: 'US$ 85,00' },
    ],
  },
];

const totalProdutos = categorias.reduce((n, c) => n + c.produtos.length, 0);
---

<!-- ══════════════ HEADER ══════════════ -->
<section class="bg-[#ECF5FA]">
  <div class="container-x py-12 md:py-16 max-w-3xl mx-auto text-center">
    <span class="mono uppercase text-primary text-[0.68rem] tracking-widest mb-3 inline-block">Catálogo LifeWave</span>
    <h1 class="text-ink mb-4">
      Produtos LifeWave
    </h1>
    <p class="text-ink-muted text-base leading-relaxed mb-6">
      Conheça a linha completa de {totalProdutos} produtos LifeWave — adesivos de fototerapia, suplementos celulares, cuidados com a pele e a tecnologia da água.
    </p>
    <a href={waLink} target={waNumber ? '_blank' : undefined} rel={waNumber ? 'noopener' : undefined}
       class="btn btn-primary inline-flex items-center gap-2 px-6 py-3 text-sm">
      Falar com um Brand Partner
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
    <p class="text-ink-faint text-xs mt-4 max-w-xl mx-auto">
      No Brasil, a compra é feita com orientação de um Brand Partner (representante autorizado). Preços de referência em dólar (USD).
    </p>
  </div>
</section>

<!-- ══════════════ CATÁLOGO ══════════════ -->
<div class="container-x py-12 md:py-16">
  <div class="max-w-5xl mx-auto space-y-12 md:space-y-14">
    {categorias.map((cat) => (
      <section>
        <h2 class="text-ink mb-6 pb-2 border-b border-[#5EB3E4]/30">
          {cat.nome}
          <span class="text-ink-faint font-normal text-sm ml-2">({cat.produtos.length})</span>
        </h2>
        <div class="grid gap-4 md:gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {cat.produtos.map((p) => (
            <div class="bg-[#ECF5FA] rounded-2xl p-5 flex flex-col">
              <h3 class="text-ink mb-2">{p.nome}</h3>
              <p class="text-sm text-ink-muted leading-relaxed mb-4 flex-1">{p.desc}</p>
              <span class="font-semibold text-primary text-sm">{p.preco}</span>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</div>

<!-- ══════════════ CTA COMO COMPRAR ══════════════ -->
<section class="bg-[#194F90]">
  <div class="container-x py-12 md:py-14 text-center text-white max-w-2xl mx-auto">
    <h2 class="!text-white mb-3">Como comprar</h2>
    <p class="text-white/85 text-sm md:text-base leading-relaxed mb-6">
      No Brasil, os produtos LifeWave são adquiridos com orientação de um Brand Partner, que acompanha todo o processo — do pedido à entrega.
    </p>
    <a href={waLink} target={waNumber ? '_blank' : undefined} rel={waNumber ? 'noopener' : undefined}
       class="btn inline-flex items-center gap-2 px-6 py-3 text-sm bg-white !text-[#194F90] hover:brightness-95">
      Falar com um Brand Partner
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>

<!-- ══════════════ AVISO ══════════════ -->
<section class="container-x py-8 max-w-3xl mx-auto">
  <p class="text-xs text-ink-faint leading-relaxed text-center">
    Os produtos LifeWave destinam-se ao bem-estar geral e não se destinam a diagnosticar, tratar, curar ou prevenir doenças. Itens ingeríveis não foram avaliados pela FDA. Consulte um profissional de saúde antes do uso. Preços em USD, sujeitos a alteração pela LifeWave.
  </p>
</section>
