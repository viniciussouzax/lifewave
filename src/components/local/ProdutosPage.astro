---
/**
 * ProdutosPage.astro, catálogo completo dos produtos LifeWave (25 itens).
 * Layout espelha a loja oficial: filtros na lateral + grade de 3 colunas.
 * Cada produto: foto oficial (public/assets/produtos), descrição e link pro artigo.
 * No Brasil a compra é com orientação de um Brand Partner, daí a CTA pro WhatsApp.
 */
import { readData } from '../../lib/readData';
import { produtos } from '../../lib/produtos';

const biz = readData('localBusiness.json', {}) as any;
const waNumber = (biz.whatsapp || '').replace(/\D/g, '');
const waLink = waNumber
  ? `https://wa.me/${waNumber}?text=${encodeURIComponent('Olá! Vim pelo site e gostaria de conhecer os produtos LifeWave.')}`
  : '/';

/**
 * linha = filtro "Linhas de Produto"; necessidade = filtro "Necessidade".
 * precoNum alimenta o filtro de faixa de preço (valor de referência em USD).
 */

/** Produto pode pertencer a mais de uma linha/necessidade (kits, p.ex.), então cada
 *  filtro conta quantos itens o atendem e some quando não houver nenhum. */
const contar = (campo: 'linhas' | 'necessidades') => {
  const m = new Map<string, number>();
  produtos.forEach((p) => p[campo].forEach((v) => m.set(v, (m.get(v) || 0) + 1)));
  return [...m.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
};
const linhas = contar('linhas');
const necessidades = contar('necessidades');

/** Cabeçalho da página (título + CTA). Oculto a pedido; true reexibe. */
const mostrarCabecalho = false;
const precoMin = Math.floor(Math.min(...produtos.map((p) => p.precoNum)));
const precoMax = Math.ceil(Math.max(...produtos.map((p) => p.precoNum)));
---

<!-- ══════════════ HEADER ══════════════
     Oculto a pedido. Para reexibir, troque para true (nada foi apagado). -->
{!mostrarCabecalho && <h1 class="sr-only">Produtos LifeWave</h1>}

<section class="bg-[#ECF5FA]" style={mostrarCabecalho ? undefined : 'display:none'}>
  <div class="container-x py-12 md:py-16 max-w-3xl mx-auto text-center">
    <span class="mono uppercase text-primary text-[0.68rem] tracking-widest mb-3 inline-block">Catálogo LifeWave</span>
    <h1 class="text-ink mb-4">Produtos LifeWave</h1>
    <p class="text-ink-muted text-base leading-relaxed mb-6">
      Conheça a linha completa de {produtos.length} produtos LifeWave: adesivos de fototerapia, suplementos celulares, cuidados com a pele e a tecnologia da água.
    </p>
    <a href={waLink} target={waNumber ? '_blank' : undefined} rel={waNumber ? 'noopener' : undefined}
       class="btn btn-primary inline-flex items-center gap-2 px-6 py-3 text-sm">
      Falar com um Brand Partner
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
    <p class="text-ink-faint text-xs mt-4 max-w-xl mx-auto">
      No Brasil, a compra é feita com orientação de um Brand Partner (representante autorizado). Preços de referência em dólar (USD).
    </p>
  </div>
</section>

<!-- ══════════════ CATÁLOGO COM FILTROS ══════════════ -->
<div class="container-x py-10 md:py-14">
  <!-- Breadcrumb: só aqui e nos artigos de produto (a pedido) -->
  <nav class="mono uppercase text-ink-faint text-xs mb-8" aria-label="Breadcrumb">
    <a href="/" class="hover:text-ink transition-colors">início</a>
    <span class="mx-2 opacity-50">/</span>
    <span class="text-ink-muted">produtos</span>
  </nav>

  <div class="grid lg:grid-cols-[230px_1fr] gap-8 lg:gap-12 items-start">

    <!-- Filtros -->
    <!-- Sem sticky de propósito: a coluna é mais alta que a viewport, então fixá-la
         escondia o filtro de preço e o "Limpar tudo" e abria um vão em branco. -->
    <aside>
      <button type="button" data-filtros-toggle
              class="lg:hidden w-full flex items-center justify-between border border-[#5EB3E4]/40 rounded-xl px-4 py-3 mb-4 text-sm font-semibold text-ink">
        Filtrar produtos
        <span data-filtros-icone aria-hidden="true">+</span>
      </button>

      <div data-filtros-painel class="hidden lg:block">
        <div class="mb-7">
          <p class="font-display text-ink text-lg mb-3 pb-2 border-b border-[#5EB3E4]/30">Linhas de produto</p>
          <ul class="space-y-2">
            {linhas.map(([l, n]) => (
              <li>
                <label class="flex items-center gap-2.5 text-sm text-ink-muted cursor-pointer">
                  <input type="checkbox" data-filtro="linha" value={l} class="w-4 h-4 accent-[#194F90] cursor-pointer" />
                  <span class="flex-1">{l}</span>
                  <span class="text-ink-faint text-xs tabular-nums">{n}</span>
                </label>
              </li>
            ))}
          </ul>
        </div>

        <div class="mb-7">
          <p class="font-display text-ink text-lg mb-3 pb-2 border-b border-[#5EB3E4]/30">Necessidade</p>
          <ul class="space-y-2">
            {necessidades.map(([nec, n]) => (
              <li>
                <label class="flex items-center gap-2.5 text-sm text-ink-muted cursor-pointer">
                  <input type="checkbox" data-filtro="necessidade" value={nec} class="w-4 h-4 accent-[#194F90] cursor-pointer" />
                  <span class="flex-1">{nec}</span>
                  <span class="text-ink-faint text-xs tabular-nums">{n}</span>
                </label>
              </li>
            ))}
          </ul>
        </div>

        <div class="mb-7">
          <p class="font-display text-ink text-lg mb-3 pb-2 border-b border-[#5EB3E4]/30">Preço</p>
          <p class="text-sm text-ink-muted mb-3">
            Até <span data-preco-label class="font-semibold text-primary">US$ {precoMax.toLocaleString('pt-BR')}</span>
          </p>
          <input type="range" data-preco-range min={precoMin} max={precoMax} value={precoMax} step="1"
                 class="w-full accent-[#194F90] cursor-pointer" aria-label="Preço máximo" />
        </div>

        <button type="button" data-limpar
                class="text-sm font-semibold text-primary hover:underline transition-colors uppercase tracking-wide">
          Limpar tudo
        </button>
      </div>
    </aside>

    <!-- Grade -->
    <div>
      <!-- Título só para leitores de tela: evita pular de h1 direto pros h3 dos cards -->
      <h2 class="sr-only">Catálogo de produtos</h2>
      <p class="text-sm text-ink-faint mb-6"><span data-contador>{produtos.length}</span> produtos</p>

      <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {produtos.map((p) => (
          <a href={`/${p.slug}`}
             class="flex flex-col no-underline group"
             data-produto
             data-linhas={p.linhas.join('|')}
             data-necessidades={p.necessidades.join('|')}
             data-preco={p.precoNum}>
            <div class="bg-white rounded-xl aspect-[4/3] overflow-hidden">
              <img src={`/assets/produtos/${p.img}`} alt={p.nome} loading="lazy" width="480" height="360"
                   class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300" />
            </div>
            <h3 class="text-center text-ink mt-4 mb-2 group-hover:underline transition-colors">{p.nome}</h3>
            <p class="text-center text-sm text-ink-muted leading-relaxed mb-3 flex-1">{p.desc}</p>
            <span class="text-center font-semibold text-primary text-sm">{p.preco}</span>
          </a>
        ))}
      </div>

      <p data-vazio class="hidden text-center text-ink-muted py-16">
        Nenhum produto encontrado com esses filtros.
      </p>
    </div>
  </div>
</div>

<!-- ══════════════ CTA COMO COMPRAR ══════════════ -->
<section class="bg-[#194F90]">
  <div class="container-x py-12 md:py-14 text-center text-white max-w-2xl mx-auto">
    <h2 class="!text-white mb-3">Como comprar</h2>
    <p class="text-white/85 text-sm md:text-base leading-relaxed mb-6">
      No Brasil, os produtos LifeWave são adquiridos com orientação de um Brand Partner, que acompanha todo o processo, do pedido à entrega.
    </p>
    <a href={waLink} target={waNumber ? '_blank' : undefined} rel={waNumber ? 'noopener' : undefined}
       class="btn inline-flex items-center gap-2 px-6 py-3 text-sm bg-white !text-[#194F90] hover:brightness-95">
      Falar com um Brand Partner
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>

<!-- ATENÇÃO: is:inline vai cru pro browser, JS puro (nada de TypeScript aqui). -->
<script is:inline>
  (function () {
    var cards = Array.prototype.slice.call(document.querySelectorAll('[data-produto]'));
    if (!cards.length) return;
    var checks = Array.prototype.slice.call(document.querySelectorAll('[data-filtro]'));
    var range = document.querySelector('[data-preco-range]');
    var label = document.querySelector('[data-preco-label]');
    var contador = document.querySelector('[data-contador]');
    var vazio = document.querySelector('[data-vazio]');

    function marcados(tipo) {
      var out = [];
      for (var i = 0; i < checks.length; i++) {
        if (checks[i].getAttribute('data-filtro') === tipo && checks[i].checked) out.push(checks[i].value);
      }
      return out;
    }

    function aplicar() {
      var linhas = marcados('linha');
      var necs = marcados('necessidade');
      // no topo do slider nao filtra por preco (evita cortar o item mais caro
      // por arredondamento do step)
      var teto = Infinity;
      if (range && parseFloat(range.value) < parseFloat(range.max)) teto = parseFloat(range.value);
      var visiveis = 0;

      // um produto pode ter varias linhas/necessidades: basta uma casar
      function casa(attr, selecionados) {
        if (!selecionados.length) return true;
        var vals = (attr || '').split('|');
        for (var k = 0; k < selecionados.length; k++) {
          if (vals.indexOf(selecionados[k]) !== -1) return true;
        }
        return false;
      }

      for (var i = 0; i < cards.length; i++) {
        var c = cards[i];
        var okLinha = casa(c.getAttribute('data-linhas'), linhas);
        var okNec = casa(c.getAttribute('data-necessidades'), necs);
        var okPreco = parseFloat(c.getAttribute('data-preco')) <= teto;
        var mostra = okLinha && okNec && okPreco;
        c.style.display = mostra ? '' : 'none';
        if (mostra) visiveis++;
      }

      if (contador) contador.textContent = String(visiveis);
      if (vazio) vazio.classList.toggle('hidden', visiveis > 0);
    }

    for (var i = 0; i < checks.length; i++) checks[i].addEventListener('change', aplicar);

    if (range) {
      range.addEventListener('input', function () {
        if (label) label.textContent = 'US$ ' + Number(range.value).toLocaleString('pt-BR');
        aplicar();
      });
    }

    var limpar = document.querySelector('[data-limpar]');
    if (limpar) {
      limpar.addEventListener('click', function () {
        for (var j = 0; j < checks.length; j++) checks[j].checked = false;
        if (range) {
          range.value = range.max;
          if (label) label.textContent = 'US$ ' + Number(range.max).toLocaleString('pt-BR');
        }
        aplicar();
      });
    }

    // Abre/fecha o painel de filtros no mobile
    var toggle = document.querySelector('[data-filtros-toggle]');
    var painel = document.querySelector('[data-filtros-painel]');
    var icone = document.querySelector('[data-filtros-icone]');
    if (toggle && painel) {
      toggle.addEventListener('click', function () {
        var aberto = !painel.classList.contains('hidden');
        painel.classList.toggle('hidden', aberto);
        if (icone) icone.textContent = aberto ? '+' : '–';
      });
    }
  })();
</script>
