---
/**
 * PrismBackground.astro — fundo animado "Prism Film" (WebGL2) da página do Brazilian Conference,
 * portado do componente React (shadcn-space PrismFilm) para script puro, sem React no site público.
 * Mesmos parâmetros da conference: céu azul, prisma suave e luz clara atrás do texto.
 * Sem WebGL2 (ou com "reduzir movimento") fica o gradiente estático.
 */
interface Props { light?: string }
const {
  light = 'radial-gradient(ellipse 55% 60% at 28% 42%, rgba(236,246,255,0.82) 0%, rgba(236,246,255,0.5) 45%, rgba(236,246,255,0) 75%)',
} = Astro.props;
---

<div data-prism aria-hidden="true" class="absolute inset-0 overflow-hidden" style="background:#1a73eb"></div>
<div aria-hidden="true" class="pointer-events-none absolute inset-0" style={`background:${light}`}></div>

<script>
  const CFG = { background: '#1a73eb', color1: '#66b8ff', color2: '#dbeeff', speed: 34, size: 140, angle: -28, split: 16, hover: 60, reach: 320, startTime: 18 };
  const MAX_DPR = 2, LAYERS = 80, NEAR_SPLIT = 14, SMEAR = 0.012, TILT_RATE = 4;
  const FALLBACK = 'radial-gradient(90% 70% at 30% 40%, #dbeeff 0%, #66b8ff 35%, #1a73eb 75%)';

  const VERT = `#version 300 es
const vec2 P[3] = vec2[3](vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0));
void main() { gl_Position = vec4(P[gl_VertexID], 0.0, 1.0); }
`;
  const FIELD = `#version 300 es
precision highp float;
uniform vec2 uRes; uniform float uTime; uniform vec3 uC1; uniform vec3 uC2; uniform float uSize; uniform float uAngle;
out vec4 o;
const float LAYERS = ${LAYERS.toFixed(1)};
const float GAIN = 0.5;
const vec2 CENTRE = vec2(0.36, 0.52);
const float TILT = 2.4; const float ZOOM = 1.05; const float THETA = 2.12; const float SHEAR = 0.958; const float SHRINK = 0.95;
const vec2 WARP_FREQ = vec2(0.5, 2.7); const vec2 WARP_AMP = vec2(0.14, 0.03); const vec2 ASPECT = vec2(1.8, 0.2);
const float OFFSET = 0.33; const float GLOW = 0.0021; const float SOFT = 0.0019; const float FALLOFF = 0.37;
const float PHASE = 40.0; const float CYCLE = 0.16; const float HUE_TRAVEL = 2.0;
mat2 rot(float a) { float c = cos(a), s = sin(a); return mat2(c, s, -s, c); }
void main() {
  vec2 R = uRes;
  vec2 pos = (gl_FragCoord.xy - 0.5 * R) / R.y;
  pos = rot(uAngle) * pos / uSize;
  float t = uTime * 0.49 + PHASE;
  float breath = (-sin(uTime * 0.735) + sin(uTime * 0.49 + 1.0)) * 0.25 + 0.5;
  vec2 u = rot(TILT) * ((pos - CENTRE) * (ZOOM - breath * 0.085));
  mat2 fold = mat2(cos(THETA), sin(THETA), -SHEAR, cos(THETA));
  vec3 col = vec3(0.0);
  for (float i = 1.0; i <= LAYERS; i += 1.0) {
    u.x -= sin(u.y * WARP_FREQ.x + t + i * 0.007) * WARP_AMP.x;
    u.y -= sin(u.x * WARP_FREQ.y - t + i * 0.02) * WARP_AMP.y;
    u = fold * u * SHRINK;
    vec2 q = (u - vec2(OFFSET + breath * 0.1, 0.0)) * ASPECT;
    float g = GLOW / (dot(q, q) + SOFT) * (0.25 + breath * 0.4);
    float r = length(u);
    float k = sin(i * CYCLE + t * 1.2 + r * HUE_TRAVEL) * 0.5 + 0.5;
    col += g * mix(uC1, uC2, k) * (0.62 + 0.5 * k) * exp2(-r * FALLOFF);
  }
  vec3 x = max(col * GAIN, 0.0);
  col = (x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14);
  col = pow(clamp(col, 0.0, 1.0), vec3(0.85, 0.92, 0.98));
  col *= 1.0 - smoothstep(0.5, 1.6, length(pos)) * 0.07;
  o = vec4(col, 1.0);
}
`;
  const FINISH = `#version 300 es
precision highp float;
uniform sampler2D uField; uniform vec2 uRes; uniform float uTime; uniform vec3 uBg; uniform float uPaper; uniform float uPR;
uniform vec2 uMouse; uniform float uOn; uniform float uReach; uniform vec2 uVel; uniform vec2 uTilt; uniform float uSplit;
out vec4 o;
const float NEAR_SPLIT = ${NEAR_SPLIT.toFixed(3)};
const float SMEAR = ${SMEAR.toFixed(4)};
float ign(vec2 p, float f) { p += 5.588238 * mod(f, 64.0); return fract(52.9829189 * fract(0.06711056 * p.x + 0.00583715 * p.y)); }
vec3 scene(vec2 uv) { return texture(uField, clamp(uv, 0.0, 1.0)).rgb; }
float near(vec2 p) { vec2 d = (p - uMouse) / (uPR * uReach); return uOn * exp(-dot(d, d)); }
vec3 rgb2hsv(vec3 c) {
  vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
  vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
  vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
  float d = q.x - min(q.w, q.y);
  return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + 1e-10)), d / (q.x + 1e-10), q.x);
}
vec3 hsv2rgb(vec3 c) {
  vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
  return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}
vec3 prism(vec2 frag, vec2 uv) {
  float time = uTime * 0.22;
  float w = near(frag);
  float ang = time * 0.7 + uv.y * 1.6;
  vec2 dir = vec2(cos(ang), sin(ang)) * (1.0 - 0.5 * min(length(uTilt), 1.0)) + uTilt * 1.6;
  vec2 px = dir * uSplit;
  if (w > 1e-4) px += dir * NEAR_SPLIT * w + uVel * SMEAR * w;
  vec2 split = px * uPR / uRes;
  vec3 base = scene(uv);
  vec3 refr = vec3(scene(uv + split).r, base.g, scene(uv - split).b);
  float inten = length(base) * 0.57735;
  float presence = smoothstep(0.025, 0.2, inten);
  float phase = inten * 4.0 + dot(uv, vec2(1.6, -1.2)) + time + dot(uTilt, vec2(2.4, -1.6));
  float coat = smoothstep(0.04, 0.28, inten) * (1.0 - smoothstep(0.72, 1.0, inten));
  vec3 hsv = rgb2hsv(max(refr, 0.0));
  hsv.x += sin(phase) * (0.07 + 0.1 * w) * coat;
  hsv.y += (1.0 - hsv.y) * coat * 0.22 * smoothstep(0.04, 0.16, hsv.y);
  return mix(base, hsv2rgb(hsv), presence);
}
void main() {
  vec2 frag = gl_FragCoord.xy;
  vec3 L = max(prism(frag, frag / uRes), 0.0);
  vec3 dark = uBg + L * (1.0 - uBg);
  float strength = clamp(max(L.r, max(L.g, L.b)), 0.0, 1.0);
  vec3 paper = uBg * (1.0 - strength) + L * 0.96;
  vec3 col = mix(dark, paper, uPaper);
  col += (ign(frag, floor(uTime * 24.0)) - 0.5) / 255.0;
  o = vec4(clamp(col, 0.0, 1.0), 1.0);
}
`;

  const hex = (h: string): [number, number, number] => [parseInt(h.slice(1, 3), 16) / 255, parseInt(h.slice(3, 5), 16) / 255, parseInt(h.slice(5, 7), 16) / 255];
  const clamp = (v: number, lo: number, hi: number) => (v < lo ? lo : v > hi ? hi : v);

  function program(gl: WebGL2RenderingContext, frag: string) {
    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    };
    const vs = sh(gl.VERTEX_SHADER, VERT), fs = sh(gl.FRAGMENT_SHADER, frag);
    if (!vs || !fs) return null;
    const p = gl.createProgram()!;
    gl.attachShader(p, vs); gl.attachShader(p, fs); gl.linkProgram(p);
    gl.deleteShader(vs); gl.deleteShader(fs);
    return gl.getProgramParameter(p, gl.LINK_STATUS) ? p : null;
  }

  function mount(root: HTMLElement) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canvas = document.createElement('canvas');
    Object.assign(canvas.style, { position: 'absolute', inset: '0', width: '100%', height: '100%', display: 'block', pointerEvents: 'none' });
    root.prepend(canvas);
    const gl = canvas.getContext('webgl2', { antialias: false, alpha: false, depth: false, stencil: false });
    const field = gl && program(gl, FIELD);
    const finish = gl && program(gl, FINISH);
    if (!gl || !field || !finish) { root.style.background = FALLBACK; canvas.remove(); return; }

    const uni = (p: WebGLProgram, n: string) => gl.getUniformLocation(p, n);
    const vao = gl.createVertexArray();
    gl.bindVertexArray(vao);

    // Alvo intermediário (metade da resolução), com fallback para 8 bits sem float.
    const fbo = gl.createFramebuffer();
    let tex: WebGLTexture | null = null, tw = 0, th = 0;
    let half = !!gl.getExtension('EXT_color_buffer_float');
    const resizeTarget = (w: number, h: number) => {
      if (w === tw && h === th && tex) return;
      for (let a = 0; a < 2; a++) {
        if (tex) gl.deleteTexture(tex);
        tex = gl.createTexture();
        gl.bindTexture(gl.TEXTURE_2D, tex);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.texImage2D(gl.TEXTURE_2D, 0, half ? gl.RGBA16F : gl.RGBA8, w, h, 0, gl.RGBA, half ? gl.HALF_FLOAT : gl.UNSIGNED_BYTE, null);
        gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
        gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);
        const ok = gl.checkFramebufferStatus(gl.FRAMEBUFFER) === gl.FRAMEBUFFER_COMPLETE;
        gl.bindFramebuffer(gl.FRAMEBUFFER, null);
        if (ok || !half) break;
        half = false;
      }
      tw = w; th = h;
    };

    const ptr = { tx: 0, ty: 0, inside: false };
    const read = (e: PointerEvent) => {
      const r = root.getBoundingClientRect();
      ptr.tx = e.clientX - r.left; ptr.ty = e.clientY - r.top;
      ptr.inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
    };
    window.addEventListener('pointermove', read, { passive: true });

    const v = {
      speed: CFG.speed / 50, size: CFG.size / 100, angle: (CFG.angle * Math.PI) / 180,
      split: CFG.split, hover: CFG.hover / 100, reach: CFG.reach,
    };
    const c1 = hex(CFG.color1), c2 = hex(CFG.color2), bg = hex(CFG.background);
    const bgLum = 0.2126 * bg[0] + 0.7152 * bg[1] + 0.0722 * bg[2];
    let mx = 0, my = 0, vx = 0, vy = 0, on = 0, tiltX = 0, tiltY = 0, last = -1, clock = CFG.startTime;

    // Fora da tela, não desenha (economiza bateria no celular).
    let visible = true;
    new IntersectionObserver((es) => { visible = es[0]?.isIntersecting ?? true; }).observe(root);

    const render = (now: number) => {
      requestAnimationFrame(render);
      const dt = last < 0 ? 0 : clamp((now - last) / 1000, 0, 0.05);
      last = now;
      if (document.hidden || !visible) return;
      clock = (clock + dt * v.speed * (reduce ? 0 : 1)) % 3600;
      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
      const cw = canvas.clientWidth || 1200, ch = canvas.clientHeight || 800;
      const bw = Math.max(1, Math.round(cw * dpr)), bh = Math.max(1, Math.round(ch * dpr));
      if (canvas.width !== bw || canvas.height !== bh) { canvas.width = bw; canvas.height = bh; }
      resizeTarget(Math.max(1, Math.round(bw / 2)), Math.max(1, Math.round(bh / 2)));

      const present = ptr.inside ? 1 : 0;
      if (present && on < 0.02) { mx = ptr.tx; my = ptr.ty; }
      on += (present - on) * (1 - Math.exp(-dt * 5));
      const k = 1 - Math.exp(-dt * 16);
      const nx = mx + (ptr.tx - mx) * k, ny = my + (ptr.ty - my) * k;
      if (dt > 0) { const kv = 1 - Math.exp(-dt * 8); vx += ((nx - mx) / dt - vx) * kv; vy += ((ny - my) / dt - vy) * kv; }
      mx = nx; my = ny;
      const vLen = Math.hypot(vx, vy) / ch, vCap = vLen > 3 ? 3 / vLen : 1;
      const weight = on * v.hover;
      const kt = 1 - Math.exp(-dt * TILT_RATE);
      tiltX += (clamp((mx / cw - 0.5) * 2, -1, 1) * weight - tiltX) * kt;
      tiltY += (clamp((0.5 - my / ch) * 2, -1, 1) * weight - tiltY) * kt;

      gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
      gl.viewport(0, 0, tw, th);
      gl.useProgram(field);
      gl.uniform2f(uni(field, 'uRes'), tw, th);
      gl.uniform1f(uni(field, 'uTime'), clock);
      gl.uniform3f(uni(field, 'uC1'), c1[0], c1[1], c1[2]);
      gl.uniform3f(uni(field, 'uC2'), c2[0], c2[1], c2[2]);
      gl.uniform1f(uni(field, 'uSize'), v.size);
      gl.uniform1f(uni(field, 'uAngle'), v.angle);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      const pr = bw / cw;
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, bw, bh);
      gl.useProgram(finish);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.uniform1i(uni(finish, 'uField'), 0);
      gl.uniform2f(uni(finish, 'uRes'), bw, bh);
      gl.uniform1f(uni(finish, 'uTime'), clock);
      gl.uniform3f(uni(finish, 'uBg'), bg[0], bg[1], bg[2]);
      gl.uniform1f(uni(finish, 'uPaper'), clamp((bgLum - 0.35) / 0.3, 0, 1));
      gl.uniform1f(uni(finish, 'uPR'), pr);
      gl.uniform2f(uni(finish, 'uMouse'), mx * pr, bh - my * (bh / ch));
      gl.uniform1f(uni(finish, 'uOn'), weight);
      gl.uniform1f(uni(finish, 'uReach'), v.reach);
      gl.uniform2f(uni(finish, 'uVel'), vx * vCap, -vy * vCap);
      gl.uniform2f(uni(finish, 'uTilt'), tiltX, tiltY);
      gl.uniform1f(uni(finish, 'uSplit'), v.split);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    requestAnimationFrame(render);
  }

  document.querySelectorAll<HTMLElement>('[data-prism]').forEach(mount);
</script>
