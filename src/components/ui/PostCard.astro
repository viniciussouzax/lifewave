---
interface Props {
  post: any;
  index?: number;
}

const { post } = Astro.props;

const data = post.data ?? post;
const slug = post.slug ?? post.id;
const url = `/${slug}`;
const title = data.title || 'Sem título';
const category = data.category || '';
const date = data.pubDate || data.date || data.publishedAt;
const img = data.heroImage || data.cover || data.coverImage || '';

const MONTHS_PT = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
function fmtDate(d: any): string {
  const dt = new Date(d);
  if (isNaN(dt.getTime())) return '';
  return `${String(dt.getUTCDate()).padStart(2, '0')} ${MONTHS_PT[dt.getUTCMonth()]} ${String(dt.getUTCFullYear()).slice(-2)}`;
}
function isoDate(d: any): string | undefined {
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? undefined : dt.toISOString().slice(0, 10);
}
---

<a href={url} class="group flex items-start gap-4 sm:gap-6 py-3 no-underline -mx-3 px-3 rounded-md hover:bg-elev/60 transition-colors">
  {img && (
    <div class="shrink-0 w-24 h-16 sm:w-28 sm:h-[4.5rem] rounded overflow-hidden">
      <img src={img} alt="" loading="lazy" class="w-full h-full object-cover transition-opacity group-hover:opacity-85" />
    </div>
  )}
  <div class="flex-1 min-w-0">
    <h2 class="font-display text-lg md:text-xl text-ink leading-snug group-hover:text-primary transition-colors">
      {title}
    </h2>
    <div class="mono uppercase text-xs mt-2 flex items-center gap-2 flex-wrap">
      {category && <span class="text-ink-muted">{category}</span>}
      {category && date && <span class="text-ink-faint opacity-50" aria-hidden="true">·</span>}
      {date && <time datetime={isoDate(date)} class="text-ink-faint tabular-nums">{fmtDate(date)}</time>}
    </div>
  </div>
</a>
