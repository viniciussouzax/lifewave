---
/**
 * SocialShare.astro — Plugin Social Share
 *
 * Renderiza botões de compartilhamento com URLs funcionais.
 * Ícones oficiais via Simple Icons (lib/brandIcons). Lê config de pluginsConfig.socialShare.
 */
import { readData } from '../../lib/readData';
import { BRAND_ICONS } from '../../lib/brandIcons';

interface Props {
  title?: string;
  context?: 'post-bottom' | 'author-box';
}

const { title = '', context = 'post-bottom' } = Astro.props;

const pluginsConfig = readData('pluginsConfig.json', {}) as any;
const shareConfig = pluginsConfig?.socialShare;
const enabled = shareConfig?.enabled !== false;
const style = shareConfig?.style || 'icon';
const platforms: string[] = shareConfig?.platforms || [
  'facebook', 'twitter', 'whatsapp', 'linkedin', 'telegram', 'copy'
];

// Ícone de "copiar" (não é marca — glyph genérico) e "check" de feedback.
const COPY_PATH = 'M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z';

const platformDefs: Record<string, { path: string; label: string }> = {
  facebook:  { path: BRAND_ICONS.facebook,  label: 'Facebook'  },
  twitter:   { path: BRAND_ICONS.x,         label: 'Twitter/X' },
  whatsapp:  { path: BRAND_ICONS.whatsapp,  label: 'WhatsApp'  },
  linkedin:  { path: BRAND_ICONS.linkedin,  label: 'LinkedIn'  },
  telegram:  { path: BRAND_ICONS.telegram,  label: 'Telegram'  },
  pinterest: { path: BRAND_ICONS.pinterest, label: 'Pinterest' },
  copy:      { path: COPY_PATH,             label: 'Copiar'    },
};

const activePlatforms = platforms.filter(p => platformDefs[p]);
---

{enabled && activePlatforms.length > 0 && (
  <div class="walker-share-wrap" data-context={context}>
    <ul
      class="social-icons list-unstyled list-inline mb-0 walker-share-list"
      data-style={style}
    >
      {activePlatforms.map(p => {
        const def = platformDefs[p];
        return (
          <li class="list-inline-item" data-platform={p}>
            <a href="#" class="walker-share-btn" aria-label={`Compartilhar no ${def.label}`} title={def.label}>
              <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d={def.path}></path></svg>
              {(style === 'label' || style === 'both') && (
                <span class="share-label ms-1">{def.label}</span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
)}

<style>
  .walker-share-wrap {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .walker-share-wrap[data-context="post-bottom"] {
    align-items: flex-end;
  }

  .walker-share-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .walker-share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    background: #194f90;
    color: #fff;
    text-decoration: none;
    transition: filter .15s ease, transform .15s ease;
  }

  .walker-share-btn:hover { filter: brightness(1.1); transform: translateY(-1px); }

  /* Variantes com rótulo: vira pílula com texto ao lado do ícone. */
  .walker-share-list[data-style="label"] .walker-share-btn,
  .walker-share-list[data-style="both"] .walker-share-btn {
    width: auto;
    padding: 0 14px;
    gap: 7px;
    font-size: .82rem;
    font-weight: 600;
  }
  .walker-share-list[data-style="label"] .walker-share-btn svg { display: none; }
</style>

<script>
(function() {
  var CHECK_PATH = 'M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z';
  function initShareButtons() {
    var lists = document.querySelectorAll('.walker-share-list');
    lists.forEach(function(list) {
      var pageUrl = encodeURIComponent(window.location.href);
      var pageTitle = encodeURIComponent(document.title);
      var btns = list.querySelectorAll('.walker-share-btn');
      btns.forEach(function(btn) {
        var li = btn.closest('[data-platform]') as HTMLElement;
        var platform = li?.dataset.platform;
        if (!platform) return;

        var urls: Record<string, string> = {
          facebook:  'https://www.facebook.com/sharer/sharer.php?u=' + pageUrl,
          twitter:   'https://twitter.com/intent/tweet?url=' + pageUrl + '&text=' + pageTitle,
          whatsapp:  'https://wa.me/?text=' + pageTitle + '%20' + pageUrl,
          linkedin:  'https://www.linkedin.com/sharing/share-offsite/?url=' + pageUrl,
          telegram:  'https://t.me/share/url?url=' + pageUrl + '&text=' + pageTitle,
          pinterest: 'https://pinterest.com/pin/create/button/?url=' + pageUrl,
          copy:      'copy',
        };

        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var url = urls[platform!];
          if (url === 'copy') {
            navigator.clipboard?.writeText(window.location.href).then(function() {
              var label = (btn as HTMLElement).querySelector('.share-label');
              var pathEl = (btn as HTMLElement).querySelector('svg path');
              if (label) {
                var original = label.textContent;
                label.textContent = 'Copiado!';
                setTimeout(function() { if (label) label.textContent = original; }, 2000);
              } else if (pathEl) {
                var originalD = pathEl.getAttribute('d');
                pathEl.setAttribute('d', CHECK_PATH);
                setTimeout(function() { if (pathEl && originalD) pathEl.setAttribute('d', originalD); }, 2000);
              }
            });
          } else {
            window.open(url, '_blank', 'noopener,width=600,height=450');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShareButtons);
  } else {
    initShareButtons();
  }
})();
</script>
