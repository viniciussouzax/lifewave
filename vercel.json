{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/process-sequences",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:caminho((?!_p/|webinar-app/|api/|_astro/|favicon|robots\\.txt|sitemap).*)",
      "has": [
        {
          "type": "host",
          "value": "(?<campanha>(?!(?:www|edge|lifewave)\\.)[a-z0-9-]+)\\.brandpartner\\.team"
        }
      ],
      "destination": "/:campanha/:caminho"
    },
    {
      "source": "/search/:term",
      "destination": "/search?q=:term"
    }
  ]
}
